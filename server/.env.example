# Copy to .env and fill in.  Only ARLO_USERNAME / ARLO_PASSWORD are required.

# --- Arlo login ---------------------------------------------------------------
# Tip: create a second Arlo account, share your cameras to it from the main
# account, and use that here. Arlo logs out other sessions on the same account.
ARLO_USERNAME=
ARLO_PASSWORD=

# 2FA. "console" = type the emailed code into the container on first login:
#   docker attach arlo-keeper   (then Ctrl-P Ctrl-Q to detach)
# "imap" = read the code from the inbox automatically (Gmail needs an app password).
TFA_SOURCE=console
TFA_TYPE=email
#TFA_HOST=imap.gmail.com
#TFA_USERNAME=you@gmail.com
#TFA_PASSWORD=gmail-app-password

# --- Clips --------------------------------------------------------------------
CLIP_MAX_SECONDS=20        # trim anything longer (0 = don't trim)
KEEP_DAYS=90               # delete un-starred clips older than this (0 = forever)
MAX_STORAGE_GB=0           # delete oldest un-starred clips past this size (0 = no cap)
LIBRARY_DAYS=7             # how far back to pull on first run
POLL_MINUTES=5             # safety-net sweep for anything the live feed missed
USE_BASE_STATION_STORAGE=true
CAPTURE_LIVE=true         # record from live view on motion (needed without a plan)
CAPTURE_CLOUD=true        # also download clips Arlo saved itself
CAPTURE_COOLDOWN_SECONDS=30
TRANSCODE_H264=true       # convert HEVC so clips play in any browser

# --- Notifications -----------------------------------------------------------
# Easiest: leave these blank and set everything on the web page's Alerts tab.
# Anything filled in here is only a starting value.
NOTIFY_ON_CLIP=true        # alert once the clip is saved (includes thumbnail)
NOTIFY_ON_MOTION=false     # alert the instant motion starts (no picture yet)
NOTIFY_COOLDOWN_SECONDS=60

# ntfy: free phone push, no account needed. Install the ntfy app and subscribe
# to the same hard-to-guess topic name.
NTFY_URL=
#NTFY_URL=https://ntfy.sh/arlo-keeper-change-this-xyz123

# Pushover ($5 one-time app)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Text messages via Twilio (needs a Twilio number)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SMS_TO=                    # numbers to start with, comma-separated

# Generic JSON POST (Home Assistant webhook, etc.)
WEBHOOK_URL=

# Address of this box, used for "open clip" links in alerts
PUBLIC_URL=
#PUBLIC_URL=http://192.168.5.50:8080

# --- Web viewer ---------------------------------------------------------------
WEB_PORT=8080
WEB_USER=
WEB_PASSWORD=
LOG_LEVEL=INFO
