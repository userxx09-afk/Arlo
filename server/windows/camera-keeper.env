# Camera Keeper settings (Windows). Arlo sign-in, phone numbers and alert accounts are set on the
# web page; this file is only for the few things below. Edit it as administrator, then use
# Start menu > Camera Keeper > Restart Camera Keeper. Updates and uninstalling leave this file alone.

WEB_PORT=8090
CLIP_MAX_SECONDS=20
KEEP_DAYS=90
MAX_STORAGE_GB=4
LIBRARY_DAYS=7
POLL_MINUTES=5
USE_BASE_STATION_STORAGE=true
# How often to ask Blink for new motion clips, in seconds (Blink accounts are added on the Arlo page)
BLINK_POLL_SECONDS=30

# Address used for "open clip" links in alerts. Blank = this PC's home-network address.
PUBLIC_URL=

# Where clips and the database live. Blank = C:\ProgramData\CameraKeeper
#DATA_DIR=D:\CameraKeeper
